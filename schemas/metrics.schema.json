{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RumorDiffusion canonical metrics artifact",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "metric_definition", "metrics", "source_predictions"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "metric_definition": {
      "type": "object",
      "required": ["class_space", "ece_bins", "ci_method"]
    },
    "metrics": {"type": "object", "minProperties": 1},
    "source_predictions": {"type": "object", "required": ["path", "sha256", "schema_version"]},
    "sample_count": {"type": "integer", "minimum": 1},
    "source_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
